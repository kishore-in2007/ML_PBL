# --- Database ---
DATABASE_URL=sqlite:///./ps5.db

# --- JWT Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Field-level encryption (Fernet key, 32 url-safe base64 bytes) ---
FIELD_ENCRYPTION_KEY=YSbEXEE08ySB8460fInZdnDwn9DOWWT94HZ95TXZdcc=

# --- S3 / S3-compatible storage (AWS S3, MinIO, etc.) ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ps5-wound-images
S3_REGION=us-east-1

# --- ML model artifacts ---
CLASSIFIER_ONNX_PATH=Ml_training/models/onnx/wound_classifier_phase1_final.onnx
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_CLASS_NAMES=mild_concern,normal,urgent
SEGMENTATION_BACKEND=medsam
MEDSAM_CHECKPOINT_PATH=Ml_training/models/medsam/medsam_vit_b.pth
SEGMENTATION_PX_PER_CM=40.0

# --- Triage ---
CONFIDENCE_THRESHOLD=0.7
