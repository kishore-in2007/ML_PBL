# =================================================================
# VITHARA FRONTEND ENVIRONMENT VARIABLES
# =================================================================

# Backend API Base URL
# When deploying to Vercel, set this environment variable in the Vercel Dashboard:
# Project Settings -> Environment Variables -> Key: VITE_API_BASE_URL
#
# Examples:
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (e.g. Render / Railway / Fly.io / VPS):
# VITE_API_BASE_URL=https://your-vithara-backend.onrender.com
